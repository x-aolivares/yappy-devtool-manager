# Example: Environment config
# Copy this file to env.<your-environment> and fill in the values
AWS_PROFILE=xxxx-profile
AWS_ENVIRONMENT=xx
AWS_REGION=us-west-x
AWS_INSTANCE=i-xxxxxxxxxx
AWS_CLUSTER=xxxxxxxxxx
DB_PORT=8xxx
KAFDROP_PORT=xxxx
DATABRICKS_PORT=xxxx
AWS_HOST=xxxx-xxxxx-data-infra-${AWS_ENVIRONMENT}-aurora-cluster.cluster-${AWS_CLUSTER}.${AWS_REGION}.rds.amazonaws.com
DATABRICKS_HOST=xxxx-lakehouse-${AWS_ENVIRONMENT}.cloud.databricks.com

# --- RDS IAM auth (DB explorer + query console in the web) ---
# TLS is mandatory for RDS: the IAM token is a password, so sending it
# unencrypted would leak IAM access. `yappy web ca` downloads the official bundle
# to ~/.aws/rds-combined-ca-bundle.pem and that is all you normally need.
#
# Only set this if you keep the bundle somewhere else. A path that does not
# exist is a hard error (it means the config is wrong); having no bundle at all
# is not — the connection stays encrypted, just unverified.
# RDS_CA_PATH=C:/Users/<user>/.aws/rds-combined-ca-bundle.pem
