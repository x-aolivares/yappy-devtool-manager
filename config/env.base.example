# Shared defaults - loaded for all environments
AWS_PROFILE=base-profile
AWS_USER=your-user@example.com
AWS_PORT=53360
# KAFKA_PATH defaults to <project_root>/devkit/kafka — override only if needed
CLUSTER_DOMAIN=yourdomain.com

# --- Local MySQL (migration target for the web's DB explorer) ---
# The web can create the database and apply DDL here, and can start/stop the
# server for you. Without LOCAL_MYSQL_START_CMD it won't guess at a service
# name — set the one that matches your machine.
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=
# Default target schema for migrations. Leave empty to use <env>_<schema>,
# which keeps dev and qa from colliding on the same local database.
LOCAL_DB_NAME=
# Windows service:      net start MySQL80
# Standalone server:    C:/xampp/mysql/bin/mysqld.exe --defaults-file=C:/xampp/mysql/bin/my.ini
# LOCAL_MYSQL_START_CMD=net start MySQL80
# LOCAL_MYSQL_STOP_CMD=net stop MySQL80
# Set to true only if your local server actually requires TLS (most don't).
LOCAL_DB_SSL=false
