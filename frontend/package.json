{
  "name": "frontend",
  "version": "0.4.6",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "dev": "ng build --watch --configuration development",
    "test": "ng test",
    "api:spec": "python -c \"import json,pathlib,yappy_api.app as a; pathlib.Path('openapi.json').write_text(json.dumps(a.app.openapi(), indent=2, ensure_ascii=False)+chr(10), encoding='utf-8')\"",
    "api:gen": "npm run api:spec && ng-openapi-gen",
    "api:check": "npm run api:spec && git diff --quiet -- openapi.json || (echo 'openapi.json quedó desactualizado: corré npm run api:gen' && exit 1)"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "ng-openapi-gen": "^1.0.5",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
