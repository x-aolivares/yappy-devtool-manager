# Example: Environment config
# Copy this file to env.<your-environment> and fill in the values
#
# OJO: los valores NO se interpolan. `${AWS_ENVIRONMENT}` queda literal, así
# que el hostname de abajo va con el valor escrito a mano.
AWS_PROFILE=xxxx-profile
# Para usar el MySQL nativo de la máquina, marcá el ambiente como local con
# CUALQUIERA de estas dos claves (no las dos):
#   DB_MODE=local          -> la forma explícita
#   AWS_ENVIRONMENT=local  -> la que este template documentó siempre
# Un ambiente local no tiene SSM, ECS ni túnel de Aurora: la web esconde esas
# filas y la CLI rechaza los comandos que irían a AWS.
AWS_ENVIRONMENT=xxxx
AWS_REGION=us-west-x
# Opcional — apunta AWS a un endpoint local (ej. LocalStack). Si AWS_ENDPOINT_URL no está,
# el perfil `localstack` usa http://localhost:4566 por defecto.
AWS_ENDPOINT_URL=
AWS_INSTANCE=i-xxxxxxxxxx
AWS_CLUSTER=xxxxxxxxxx
# El puerto LOCAL donde escucha el túnel SSM a la base (no el puerto de MySQL).
DB_PORT=8xxx
KAFDROP_PORT=xxxx
DATABRICKS_PORT=xxxx
AWS_HOST=xxxx-xxxxx-data-infra-xxxx-cluster.cluster-xxxxxxxxxx.xxxx.rds.amazonaws.com
DATABRICKS_HOST=xxxx-lakehouse-${AWS_ENVIRONMENT}.cloud.databricks.com

# Region Sync — conexión directa opcional a la base (sin túnel SSM).
# Si NO existen AWS_INSTANCE/AWS_HOST/AWS_PORT, el tool de diff de DB usa estos valores
# para conectarse directo por TCP. DB_USER/DB_PASSWORD también se leen de config/.env.local.
# DB_MODE=local marca el ambiente entero como local (ver arriba).
# DB_MODE=
DB_HOST=
# El puerto de MySQL de la conexión directa. OJO: no es el DB_PORT de arriba,
# que es el puerto local del túnel. Antes las dos cosas usaban la misma clave
# con defaults distintos (8100 y 3306); ahora cada una tiene la suya.
# DB_MYSQL_PORT=3306
DB_USER=
DB_PASSWORD=

# Opcional — tope de ejecución (ms) para las consultas de la página "Ejecutar SQL".
# MySQL corta la sentencia y la respuesta lo dice; 0 desactiva el tope.
# DB_QUERY_TIMEOUT_MS=60000
