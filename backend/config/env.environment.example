# Example: Environment config
# Copy this file to env.<your-environment> and fill in the values
AWS_PROFILE=xxxx-profile
AWS_ENVIRONMENT=xx
AWS_REGION=us-west-x
# Opcional — apunta AWS a un endpoint local (ej. LocalStack). Si AWS_ENDPOINT_URL no está,
# el perfil `localstack` usa http://localhost:4566 por defecto.
AWS_ENDPOINT_URL=
AWS_INSTANCE=i-xxxxxxxxxx
AWS_CLUSTER=xxxxxxxxxx
DB_PORT=8xxx
KAFDROP_PORT=xxxx
DATABRICKS_PORT=xxxx
AWS_HOST=xxxx-xxxxx-data-infra-${AWS_ENVIRONMENT}-aurora-cluster.cluster-${AWS_CLUSTER}.${AWS_REGION}.rds.amazonaws.com
DATABRICKS_HOST=xxxx-lakehouse-${AWS_ENVIRONMENT}.cloud.databricks.com

# Region Sync — conexión directa opcional a la base (sin túnel SSM).
# Si NO existen AWS_INSTANCE/AWS_HOST/AWS_PORT, el tool de diff de DB usa estos valores
# para conectarse directo por TCP. DB_USER/DB_PASSWORD también se leen de config/.env.local.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
