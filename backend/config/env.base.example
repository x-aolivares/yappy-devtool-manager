# Shared defaults - loaded for all environments
ORG_DOMAIN=yappy
AWS_PROFILE=base-profile
AWS_USER=aolivares@yappy.com.pa
AWS_PORT=53360
KAFKA_PATH=/c/Development/config/kafka
# Opcional: a qué broker se conecta el Kafka Agent (host:puerto, separados por
# coma). Sin esto usa 127.0.0.1 y el puerto de `listeners=` del server.properties.
# KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
WORKSPACE_PATH=/c/Development/workspace
CLUSTER_DOMAIN=yappycloud.com

# --- Catálogo de túneles ("Workflow / Recursos") -----------------------------
# Qué puertos locales de cada cluster conviene reenviar, y a qué servicio
# corresponde. Es lo que la pantalla dibuja como filas; lo que no esté acá no
# aparece, y agregarlo desde la pantalla lo escribe acá.
#
# Va en env.base y no en env.<ambiente> a propósito: el puerto es local, el
# ambiente es remoto. El mismo catálogo vale para dev, qa y uat.
#
# Formato: <cluster>=<puerto>:<nombre>,<puerto>:<nombre>;...  (el nombre puede
# quedar vacío: un puerto se puede reenviar antes de que nadie lo nombre).
# Un puerto repetido en el mismo grupo se ignora, y una entrada que no sea un
# número se descarta sola sin llevarse el resto del grupo.
#
# Los alias de cluster son los de `adapters/ssm/targets.py`: cap, cap2, int.
CLUSTER_PORTS=cap=8402:core-p2m-m2p,8403:commerce-profile;cap2=8412:personal-profile,8413:;int=

# --- Forwarder de túneles -----------------------------------------------------
# `ssm start-session` cumple una cosa más chica de lo que parece: levanta un
# proceso local que hace bind del puerto local y reenvía TCP al host remoto, y
# usa AWS sólo para llegar a una red a la que la máquina no tiene ruta. Eso
# alcanza para probar todo el camino del túnel —tracker, probe, supervisor,
# guard de puertos, cleanup— contra los MySQL de Docker sin depender de AWS.
#
# TUNNEL_FORWARDER=local levanta ese proceso local en vez del de AWS. Con
# `ssm` (el default, y lo que corre si esta línea no existe) no cambia nada.
# Ojo con el valor mal escrito: cae en `ssm` en vez de fallar.
# TUNNEL_FORWARDER=ssm
#
# Destino del forwarder local. El 3306 es el MySQL de dev, que es el primero que
# levanta el stack; para qa es 3307 y para local 3308.
#
# Los defaults de abajo son los de una sesión real, y por eso están: ~3s para
# que la sesión se establezca (de ahí los 30s de `connection._wait_for_port`),
# y 60s sin mover un byte antes de que Session Manager termine la sesión sola —
# que es como una fila pasa de `up` a `dead` sin error y sin que nadie toque
# nada. Los otros dos son 0 = nunca: existen para poder ver un fallo, no para
# provocarlo por defecto.
# TUNNEL_LOCAL_HOST=127.0.0.1
# TUNNEL_LOCAL_PORT=3306
# TUNNEL_LOCAL_STARTUP_DELAY=3.0
# TUNNEL_LOCAL_IDLE_TIMEOUT=60.0
# TUNNEL_LOCAL_STALL_AFTER=0
# TUNNEL_LOCAL_DIE_AFTER=0

# --- "Rama desplegada por ambiente" (Bitbucket + ECS + CircleCI) ----------------
# Sólo para repos de ECS/Fargate. La cadena lee el .circleci/parameters.json del
# repo, de ahí arma la familia del task definition en cada región, saca el id de
# pipeline del tag de la imagen y lo cruza con CircleCI.
# Sin BITBUCKET_* la pantalla dice que falta la config. Con BITBUCKET_* pero sin
# CIRCLECI_TOKEN se sabe qué pipeline desplegó pero no en qué rama: la tabla lo
# muestra así, no oculta lo que sí se resolvió.
# API token de Atlassian (Bitbucket): https://id.atlassian.com/manage-profile/security/api-tokens
# Va como `Authorization: Bearer <token>`, sin usuario ni password: es el mismo
# esquema y el mismo token que usa bbit-release-manager (BBIT_BITBUCKET_TOKEN).
BITBUCKET_TOKEN=
# Workspace/proyecto de Bitbucket (el `bg-ti` de git@bitbucket.org:bg-ti/<repo>.git).
BITBUCKET_WORKSPACE=bg-ti
# Personal API Token: https://app.circleci.com/settings/tokens
CIRCLECI_TOKEN=
# Prefijo del slug de CircleCI. El `bb/` va delante y NO es el workspace: sale
# de la URL de CircleCI, no del remote de git. Cambiarlo si tus pipelines no
# están en bb/<workspace>.
CIRCLECI_SLUG_PREFIX=bb/bg-ti

# Opcional — tope de ejecución (ms) para las consultas de la página "Ejecutar SQL".
# MySQL corta la sentencia y la respuesta lo dice; 0 desactiva el tope.
# DB_QUERY_TIMEOUT_MS=60000