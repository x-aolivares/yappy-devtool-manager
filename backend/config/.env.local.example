# Variables que `yappy run db <env>` escribe en backend/config/.env.local para
# las pruebas locales. El archivo real lo genera la herramienta: no se edita a
# mano. Este template documenta qué claves tienen que estar, sí o sí, y con
# estos nombres exactos.
#
# De dónde sale cada valor:
#   DATABASE_USR  AWS_USER de env.base (ambientes AWS) o DB_USER de env.local
#   DATABASE_PRT  DB_PORT del ambiente
#   AWS_REGION    AWS_REGION del ambiente (REGION lleva el mismo valor)
#   ENV           el ambiente que se corrió (local, qa, uat, ...)
#   DATABASE_PWD  token RDS en ambientes AWS; DB_PASSWORD de env.local en local
DATABASE_USR=root
DATABASE_HST=localhost
DATABASE_PRT=3306
DATABASE_TMT=60000
AWS_REGION=us-west-1
REGION=us-west-1
ENV=local
DATABASE_PWD=
DATABASE_HST_URL_WRITE=jdbc:mysql://localhost:3306
DATABASE_HST_URL_READ=jdbc:mysql://localhost:3306
